# Ollama model configuration (Ollama runs on the macOS host).
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
JWT_SIGNING_KEY=replace-with-a-random-32-character-minimum-secret
APP_ENV=development
# Production values must be explicit HTTPS origins and concrete hostnames.
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
MAX_REQUEST_BODY_BYTES=1048576
# Production must set DATABASE_URL and must not use the development credentials above.
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_POOL_RECYCLE_SECONDS=1800
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_LOCK_TIMEOUT_MS=5000
MIGRATION_LOCK_TIMEOUT_SECONDS=120

# MongoDB clients are topology-aware. Production always enables TLS certificate verification.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
MONGO_MAX_IDLE_TIME_MS=60000
# MONGO_TLS_CA_FILE=/run/secrets/mongodb_ca.pem
# MONGO_TLS_CERTIFICATE_KEY_FILE=/run/secrets/mongodb_client.pem

CONTROL_PLANE_MASTER_KEY_FILE=/run/secrets/control_plane_master_key

# Worker: MongoDB connections by target connection_label (worker-only secret).
# TARGET_CONNECTIONS_HOST_FILE=./infra/dev/target_connections.json
# Advisory model: ollama | openai_compatible | deterministic (no LLM)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
TELEMETRY_INTERVAL_SECONDS=30
# Sandbox evaluation bounds
EVALUATION_COPY_MAX_DOCUMENTS=250000
EVALUATION_SMOKE_PAIRS=10
EVALUATION_OPS_PER_ARM=40
# Post-deployment monitoring: observed probe windows and spacing
MONITORING_WINDOWS=3
MONITORING_WINDOW_SECONDS=20
